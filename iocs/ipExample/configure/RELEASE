# RELEASE - Location of external support modules

# Pull in EPICS_BASE and other paths from the parent module.
# Use hardcoded $(TOP)/../.. paths instead of $(IP) because
# the parent's RELEASE file may redefine IP to a different path.
-include $(TOP)/../../configure/RELEASE
-include $(TOP)/../../configure/RELEASE.local

# Override IP to point to the parent module (which was just
# redefined by the parent's RELEASE file above).
IP = $(TOP)/../..

# These lines allow developers to override these RELEASE settings
# without having to modify this file directly.
-include $(TOP)/configure/RELEASE.local

