# (Related Display)
object relatedDisplayClass
beginObjectProperties
major 4
minor 0
release 0
x 223
y 290
w 70
h 20
fgColor rgb 0 0 0
bgColor rgb 29440 57088 65280
topShadowColor rgb 55808 55808 55808
botShadowColor rgb 17920 17920 17920
font "helvetica-medium-r-12.0"
icon
buttonLabel "More"
numPvs 4
numDsps 2
displayFileName {
  0 "asynRecord.edl"
  1 "Alicat_PCD_plot_2pvs.edl"
}
menuLabel {
  0 "asyn record"
  1 "Plot setpoint and readback"
}
symbols {
  0 "P=$(P),R=$(R)Asyn"
  1 "PV1=$(P)$(R)Setpoint,PV2=$(P)$(R)Pressure_RBV,HOPR=$(P)$(R)PressureHOPR,LOPR=$(P)$(R)PressureLOPR"
}
replaceSymbols {
  0 1
  1 1
}
endObjectProperties

